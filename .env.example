# Copy to .env and fill in. Never commit .env.

# LLM providers (OpenAI-compatible APIs)
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
# deepseek | mistral | replay
A15_PROVIDER=deepseek
# Mistral EU endpoint (used by the public demo): https://api.eu.mistral.ai/v1
MISTRAL_BASE_URL=https://api.eu.mistral.ai/v1

# Secret used to sign human approvals (at least 32 random bytes, hex)
A15_APPROVAL_SECRET=

# Secret used to sign case tokens for the MCP servers (at least 32 random bytes, hex), e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
A15_SCOPE_SECRET=
# Generated company data (a15 generate) and runtime stores (scope grants, notifier messages)
A15_DATA_DIR=data/generated
A15_RUNTIME_DIR=data/runtime
# Per-tool-call timeout in seconds, and how long a case token stays valid
A15_TOOL_TIMEOUT_S=5
A15_GRANT_TTL_HOURS=24
