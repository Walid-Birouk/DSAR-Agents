# Copy to .env and fill in. Never commit .env.

# LLM providers (OpenAI-compatible APIs)
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
# deepseek | mistral | replay
A15_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
A15_DEEPSEEK_MODEL=deepseek-flash
# Mistral EU endpoint (used by the public demo): https://api.eu.mistral.ai/v1
MISTRAL_BASE_URL=https://api.eu.mistral.ai/v1
A15_MISTRAL_MODEL=mistral-small-2603
# Reasoning mode: off | low | high (decision 0010: off by default)
A15_THINKING=off
# Per model call: timeout in seconds and maximum output tokens
A15_MODEL_TIMEOUT_S=120
A15_MAX_OUTPUT_TOKENS=8192
# Per-case caps (decision 0010); a run that hits one stops and the case goes to a person
A15_CASE_MAX_CALLS=60
A15_CASE_MAX_INPUT_TOKENS=1000000
A15_CASE_MAX_SECONDS=900
A15_CASE_MAX_COST_USD=0.30

# Secret used to sign human approvals (at least 32 random bytes, hex)
A15_APPROVAL_SECRET=

# Secret used to sign case tokens for the MCP servers (at least 32 random bytes, hex), e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
A15_SCOPE_SECRET=
# Generated company data (a15 generate) and runtime stores (scope grants, notifier messages)
A15_DATA_DIR=data/generated
A15_RUNTIME_DIR=data/runtime
# Per-tool-call timeout in seconds, and how long a case token stays valid
A15_TOOL_TIMEOUT_S=5
A15_GRANT_TTL_HOURS=24
