# Production settings for deploy/docker-compose.yml. Copy to production.env (git-ignored) and fill in.
A15_DOMAIN=desk.example.org
# The session cookie is sent over HTTPS only (Caddy, or a Vercel rewrite, terminates TLS in front of the app)
A15_SECURE_COOKIES=1
# The demo's model: Mistral's EU endpoint (decision D3)
A15_WEB_PROVIDER=mistral
MISTRAL_API_KEY=
A15_MISTRAL_MODEL=mistral-small-2603
# Secrets: at least 32 random bytes, hex (python -c "import secrets; print(secrets.token_hex(32))")
A15_SCOPE_SECRET=
A15_APPROVAL_SECRET=
A15_TELEMETRY_KEY=
A15_ADVISOR_KEY=
# The private collector, if the observability stack runs on the same host
A15_OTLP_ENDPOINT=
